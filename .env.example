# Vorlage für die Umgebungsvariablen. Kopieren nach `.env.local` (Entwicklung)
# bzw. in die Umgebung des Servers (Hetzner/Docker) oder die Projekt-
# einstellungen (Vercel). `.env.local` ist per .gitignore ausgenommen —
# echte Zugangsdaten gehören nicht ins Repository.


# ─────────────────────────────────────────────────────────────────────────
# Domain
# ─────────────────────────────────────────────────────────────────────────

# Produktionsdomain. Speist Canonical, Open Graph, JSON-LD-IDs, Sitemap und
# den Sitemap-Verweis in der robots.txt (lib/site.ts).
# Ohne Wert gilt der Default https://lindermedia.de — auf der Vorschau also
# zusätzlich NEXT_PUBLIC_NOINDEX setzen (siehe unten), damit die Vorschau
# nicht gegen die Live-Domain antritt.
NEXT_PUBLIC_SITE_URL=https://lindermedia.de

# Auf der Vorschau-Instanz (z. B. lindermediaweb26.vercel.app) auf 1 setzen:
# sperrt robots.txt vollständig und setzt `noindex, nofollow` in Head und
# Response-Header. Auf dem Produktionsserver leer lassen oder ganz weglassen.
# NEXT_PUBLIC_NOINDEX=1


# ─────────────────────────────────────────────────────────────────────────
# Kontaktformular (app/api/contact)
# ─────────────────────────────────────────────────────────────────────────

# SMTP-Zugang des Postfachs, über das die Anfragen verschickt werden.
# Fehlt einer der drei Pflichtwerte, antwortet /api/contact mit 503 und
# verweist sichtbar auf die E-Mail-Adresse — eine Anfrage geht nie still
# verloren.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Empfänger der Anfragen. Ohne Angabe: die Adresse aus lib/site.ts.
# CONTACT_TO=hello@lindermedia.de

# Absenderzeile. Muss zur eigenen Domain gehören, sonst scheitern SPF/DKIM.
# Die Adresse des Absenders steht im Reply-To, nicht im From.
# CONTACT_FROM=LinderMedia Website <hello@lindermedia.de>
